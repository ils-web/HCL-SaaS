generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String       @id @default(uuid())
  name               String
  status             TenantStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  qrSettings         Json?
  telegramChatId     String?
  contactEmail       String?
  contactPhone       String?
  logoUrl            String?
  maxInspectors      Int          @default(1)
  plan               String       @default("FREE")
  price              Float        @default(0.0)
  subscriptionEndsAt DateTime?
  telegramBotToken   String?
  whatsappInstance   String?
  whatsappToken      String?
  areas              Area[]
  departments        Department[]
  invoices           Invoice[]
  qrMappings         QrMapping[]
  systems            System[]
  tasks              Task[]
  teams              Team[]
  users              User[]
}

model User {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  email         String?  @unique
  phone         String?  @unique
  password      String?
  role          Role     @default(WORKER)
  teamId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tasksAssigned Task[]   @relation("WorkerTasks")
  team          Team?    @relation(fields: [teamId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model Team {
  id         String      @id @default(uuid())
  tenantId   String
  name       String
  createdAt  DateTime    @default(now())
  qrMappings QrMapping[]
  systems    System[]
  tasks      Task[]
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  users      User[]

  @@unique([tenantId, name])
}

model Department {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tasks     Task[]
}

model Area {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  systems   System[]
  tasks     Task[]
}

model System {
  id               String   @id @default(uuid())
  tenantId         String
  name             String
  areaId           String
  autoAssignTeamId String?
  createdAt        DateTime @default(now())
  area             Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  autoAssignTeam   Team?    @relation(fields: [autoAssignTeamId], references: [id])
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  tasks            Task[]
}

model Task {
  id               String      @id @default(uuid())
  tenantId         String
  inspectorName    String?
  departmentId     String?
  room             String
  areaId           String?
  systemId         String?
  customDefectName String?
  actionType       ActionType?
  notes            String?
  photoUrl         String?
  afterPhotoUrl    String?
  status           TaskStatus  @default(NEW)
  teamId           String?
  workerId         String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  isSentToApp      Boolean     @default(false)
  lastWarnedAt     DateTime?
  area             Area?       @relation(fields: [areaId], references: [id])
  department       Department? @relation(fields: [departmentId], references: [id])
  system           System?     @relation(fields: [systemId], references: [id])
  team             Team?       @relation(fields: [teamId], references: [id])
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  worker           User?       @relation("WorkerTasks", fields: [workerId], references: [id])
}

model QrMapping {
  id       String  @id @default(uuid())
  tenantId String
  category String
  teamId   String?
  team     Team?   @relation(fields: [teamId], references: [id])
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, category])
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  company   String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model Invoice {
  id              String   @id @default(uuid())
  tenantId        String
  type            String   @default("INVOICE")
  amount          Float
  extraInspectors Int      @default(0)
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
}

enum TenantStatus {
  ACTIVE
  UNPAID
  BLOCKED
  TRIAL
}

enum Role {
  SUPERADMIN
  ADMIN
  WORKER
  INSPECTOR
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum ActionType {
  REPAIR
  REPLACE
}
